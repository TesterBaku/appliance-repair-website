{
  "name": "appliance-repair-website",
  "version": "1.0.0",
  "description": "Appliance repair service static website",
  "scripts": {
    "start": "npx serve .",
    "test": "npm run test:helpers && npm run reviews:check && node test/links.js && node test/html-integrity.js && node test/content-integrity.js && node test/css-vars.js && node test/repo-hygiene.js && node test/formspree-guard.js && node scripts/build/inject-partials.js --check && node scripts/build/inject-site-js.js --check && node scripts/build/sync-blog-counts.js --check && node scripts/build/sync-article-bylines.js --check && node scripts/build/sync-review-counts.js --check && node scripts/build/check-agents.js --check",
    "build:partials": "node scripts/build/inject-partials.js",
    "build:site-js": "node scripts/build/inject-site-js.js",
    "test:integrity": "node test/html-integrity.js",
    "test:content": "node test/content-integrity.js",
    "test:hygiene": "node test/repo-hygiene.js",
    "test:functional": "playwright test",
    "test:all": "npm test && npm run screenshot && npm run test:functional",
    "screenshot": "node test/screenshot.js",
    "build:sitemap": "node scripts/build-sitemap.js",
    "build:search": "node scripts/build-search-index.js",
    "build:blog-counts": "node scripts/build/sync-blog-counts.js",
    "build:article-bylines": "node scripts/build/sync-article-bylines.js",
    "build:review-counts": "node scripts/build/sync-review-counts.js",
    "sync:testimonials": "node scripts/build/sync-review-counts.js",
    "clean:images": "node scripts/clean-images.js",
    "clean:screenshots": "node scripts/clean-screenshots.js",
    "optimize:logo": "node scripts/optimize-logo.js",
    "build:favicons": "node scripts/build-favicons.js",
    "apply:favicon-metadata": "node scripts/apply-favicon-metadata.js",
    "prepare": "husky",
    "photos:import": "node scripts/import-job-photos.js",
    "reviews:check": "node scripts/validate-review-batch.js",
    "test:helpers": "node --test test/job-photo-import.test.js test/review-batch.test.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@secretlint/secretlint-rule-preset-recommend": "^12.2.0",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "secretlint": "^12.2.0",
    "sharp": "^0.34.5"
  }
}
