node_modules/
test/screenshots/

# Playwright output — never commit test run artifacts
test-results/
playwright-report/

# Local task/planning files and run logs — owner's working notes, not part of the site
tasks/
logs/
# Session work logs — orchestrator log + per-subagent detail files (see AGENTS.md
# "progress.md Contract"). Local working notes like tasks/ and logs/, never committed.
progress.md
progress/
# Hermes Agent per-run plan scratch (like tasks/) — local working notes, not shared config
.hermes/
*.png
!logo.png
.playwright-mcp/
photo-*.jpeg

# Audit/research screenshots — agents write here; never committed
.audits/

# Staging area for raw photo imports before classification — never committed
.staging/

# Temp images — download trial assets here during tasks; cleaned by `npm run clean:images`
images/temp/*
!images/temp/.gitkeep

# Environment and secrets — never commit these
.env
.env.*
!.env.example

# OS / editor artifacts
.DS_Store
Thumbs.db
*.local
.vscode/
# msys2 / Git-Bash crash dumps — never commit
*.stackdump

# Claude Code config. The shareable workflow library is COMMITTED — it is the single source of
# truth for every agent (Claude Code, Codex, Copilot, Hermes; see the "Workflow Library" section
# of AGENTS.md) and must be in the repo so cloud cron runners, which clone the default branch,
# can find it. Only user-local state stays ignored.
#
# `!.claude/skills/` is LOAD-BEARING, not tidiness. The six rule skills live there because
# `.claude/skills/` is one of the only directories Claude Code actually scans for skills, and
# because cloud/routine runs load project skills from the CLONED repo. Drop this negation and the
# files stop being committed, which reproduces the July 2026 failure exactly: the workflow library
# was gitignored, the cloud runner cloned a repo without it, and autonomous publishing silently
# produced nothing for weeks. (These files sat in `.agents/skills/` from 2026-08-18 until
# 2026-08-19; that path is not scanned by anything, so the Skill tool could never load them. See
# AGENTS.md "Rule Skills".)
.claude/*
!.claude/commands/
!.claude/agents/
!.claude/hooks/
!.claude/skills/
!.claude/CLAUDE.md
!.claude/settings.json

# Impeccable per-edit design hook: the local run cache is machine-local (the shared
# config .impeccable/config.json and sidecar .impeccable/design.json ARE committed).
.impeccable/hook.cache.json
# still ignored (not negated above): settings.local.json, worktrees/, and any local-only files

# Credentials and keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.json
secrets.yaml
secrets.yml
config/secrets.*

# Research downloads: never commit PDFs (a 13.6 MB City doc slipped in via git add -A, PR #662)
*.pdf
