#!/bin/sh
#
# pre-push — refuse direct pushes to the protected branches.
#
# .claude/rules/git-workflow.md has asserted since it was written that "the
# pre-push git hook enforces this automatically". Until 2026-08-02 that hook did
# not exist: .git/hooks held nothing but .sample files, so master protection was
# prose that read like enforcement. This file makes the claim true.
#
# Install with: sh scripts/install-hooks.sh   (git does not track .git/hooks,
# so every clone has to run it once).
#
# Bypass, when you genuinely mean to: git push --no-verify

protected="master main"
remote_ref_prefix="refs/heads/"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    "$remote_ref_prefix"*) branch="${remote_ref#$remote_ref_prefix}" ;;
    *) continue ;;
  esac

  for p in $protected; do
    if [ "$branch" = "$p" ]; then
      echo "" >&2
      echo "  BLOCKED: direct push to '$branch'." >&2
      echo "" >&2
      echo "  This repo routes every change through a pull request:" >&2
      echo "    branch -> commit -> npm test + npm run screenshot + npm run test:functional -> PR -> /review -> merge" >&2
      echo "  See .claude/rules/git-workflow.md." >&2
      echo "" >&2
      echo "  If you really mean it: git push --no-verify" >&2
      echo "" >&2
      exit 1
    fi
  done
done

exit 0
